# Copy to .env and adjust. NEVER commit the real .env — only this example.

# ── Django core ──────────────────────────────────────────────────────────
# Generate a fresh key for production, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=dev-only-insecure-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── CORS / CSRF (frontend origins) ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── ML artifacts (defaults resolve inside backend/) ─────────────────────────
# MODEL_PATH=models/paddy_yield_model.pkl
# METRICS_PATH=models/model_metrics.json
# DATASET_PATH=paddydataset.csv

# ── Upload guard (bytes; default 5 MB) ─────────────────────────────────────
MAX_UPLOAD_BYTES=5242880
